<?xml version="1.0" encoding="UTF-8"?>
<project
    xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath />
    </parent>

    <groupId>com.altermax</groupId>
    <artifactId>altermax</artifactId>
    <version>1.0.0</version>
    <name>Altermax</name>
    <description>Comparacao competitiva de veiculos Ford</description>

    <properties>
        <java.version>21</java.version>
        <jjwt.version>0.12.6</jjwt.version>
        <springdoc.version>2.8.13</springdoc.version>
        <spotless-maven-plugin.version>3.10.1</spotless-maven-plugin.version>
        <google-java-format.version>1.30.0</google-java-format.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>21</release>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <configuration>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <excludes>
                            <exclude>target/**/*.java</exclude>
                            <exclude>**/generated/**/*.java</exclude>
                        </excludes>
                        <googleJavaFormat>
                            <version>${google-java-format.version}</version>
                            <style>AOSP</style>
                            <reflowLongStrings>false</reflowLongStrings>
                            <formatJavadoc>true</formatJavadoc>
                        </googleJavaFormat>
                        <removeUnusedImports>
                            <engine>cleanthat-javaparser-unnecessaryimport</engine>
                        </removeUnusedImports>
                        <forbidWildcardImports />
                        <replaceRegex>
                            <name>Format validated request body parameters</name>
                            <searchRegex>\(\s*@Valid @RequestBody</searchRegex>
                            <replacement>(&#10;            @Valid&#10;            @RequestBody</replacement>
                        </replaceRegex>
                        <replaceRegex>
                            <name>Format additional validated request body parameters</name>
                            <searchRegex>,\s*@Valid @RequestBody</searchRegex>
                            <replacement>,&#10;            @Valid&#10;            @RequestBody</replacement>
                        </replaceRegex>
                        <replaceRegex>
                            <name>Format constrained request parameters</name>
                            <searchRegex>\(\s*@RequestParam @NotBlank</searchRegex>
                            <replacement>(&#10;            @RequestParam&#10;            @NotBlank</replacement>
                        </replaceRegex>
                        <replaceRegex>
                            <name>Format constrained path variables</name>
                            <searchRegex>\(\s*@PathVariable @NotBlank</searchRegex>
                            <replacement>(&#10;            @PathVariable&#10;            @NotBlank</replacement>
                        </replaceRegex>
                        <replaceRegex>
                            <name>Break before the minimum model year</name>
                            <searchRegex>@NotNull @Min\(1903\)</searchRegex>
                            <replacement>@NotNull&#10;        @Min(1903)</replacement>
                        </replaceRegex>
                        <replaceRegex>
                            <name>Break before the maximum model year</name>
                            <searchRegex>@Min\(1903\) @Max\(2100\)</searchRegex>
                            <replacement>@Min(1903)&#10;        @Max(2100)</replacement>
                        </replaceRegex>
                        <replaceRegex>
                            <name>Break after the model year constraints</name>
                            <searchRegex>@Max\(2100\) Integer</searchRegex>
                            <replacement>@Max(2100)&#10;        Integer</replacement>
                        </replaceRegex>
                        <replaceRegex>
                            <name>Break the login request record header</name>
                            <searchRegex>public record LoginRequest\(@NotBlank</searchRegex>
                            <replacement>public record LoginRequest(&#10;        @NotBlank</replacement>
                        </replaceRegex>
                        <replaceRegex>
                            <name>Break the login request record components</name>
                            <searchRegex>String username, @NotBlank</searchRegex>
                            <replacement>String username,&#10;        @NotBlank</replacement>
                        </replaceRegex>
                        <replaceRegex>
                            <name>Place Autowired on its own line</name>
                            <searchRegex>(?m)^([ \t]*)@Autowired[ \t]+</searchRegex>
                            <replacement>$1@Autowired&#10;$1</replacement>
                        </replaceRegex>
                        <replaceRegex>
                            <name>Place MockitoBean on its own line</name>
                            <searchRegex>(?m)^([ \t]*)@MockitoBean[ \t]+</searchRegex>
                            <replacement>$1@MockitoBean&#10;$1</replacement>
                        </replaceRegex>
                        <replaceRegex>
                            <name>Expand empty constructor bodies</name>
                            <searchRegex>(?m)^([ \t]*)(public|protected|private) ([A-Z]\w*)\(\) \{\}$</searchRegex>
                            <replacement>$1$2 $3() {&#10;$1}</replacement>
                        </replaceRegex>
                        <trimTrailingWhitespace />
                        <endWithNewline />
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
